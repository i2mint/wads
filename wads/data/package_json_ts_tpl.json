{
  "name": "<< npm_package_name >>",
  "version": "<< npm_version >>",
  "description": "<< description >>",
  "type": "module",
<%- if npm_repository %>
  "repository": {
    "type": "git",
    "url": "<< npm_repository >>"<% if npm_repository_directory %>,
    "directory": "<< npm_repository_directory >>"<% endif %>
  },
<%- endif %>
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
<%- if npm_engines_node %>
  "engines": {
    "node": "<< npm_engines_node >>"
  },
<%- endif %>
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "ci-local": "npm run lint && npm test && npm run build"
  },
  "license": "<< npm_license >>",
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "<< npm_vitest_range >>",
    "@types/node": "^22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "wads": {
    "ci": {
      "subdir": "<< npm_subdir >>",
      "packageManager": "<< npm_package_manager >>",
      "nodeVersions": << npm_node_versions | tojson >>,
      "publishNode": "<< npm_node_versions[-1] >>",
      "lintCommand": "npm run lint --if-present",
      "testCommand": "npm test --if-present",
      "buildCommand": "npm run build --if-present",
      "publish": {
        "enabled": false,
        "marker": "[publish-npm]",
        "registry": "https://registry.npmjs.org",
        "provenance": true,
        "trustedPublishing": true,
        "access": "public"
      }
    }
  }
}
